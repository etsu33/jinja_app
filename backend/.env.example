# Local development example.
# Copy this file to .env.local and fill in values for your machine.

# Django
DEBUG=1
DJANGO_SECRET_KEY=change-me-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Database
USE_SQLITE=0
USE_GIS=1
DISABLE_GIS_FOR_TESTS=0
DATABASE_URL=postgis://admin:password@127.0.0.1:5432/jinja_db

# Concierge / LLM
CONCIERGE_USE_LLM=0
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=300
LLM_TIMEOUT_MS=10000
LLM_RETRIES=1
LLM_BACKOFF_S=2
LLM_FORCE_CHAT=1
LLM_FORCE_JSON=0

# Throttle
DISABLE_THROTTLE=0
THROTTLE_SHRINES_INGEST=60/min

# Billing stub for local development
BILLING_STUB_PLAN=free
BILLING_STUB_ACTIVE=0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public URLs
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Google APIs
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
