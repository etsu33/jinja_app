        {
          "history_type": "tradition",
          "title": "日本武尊による創祀伝承",
          "content": "根津神社の公式由緒は、今から約千九百年前、日本武尊が東夷征定の途次、須佐之男命の御神徳を仰いで千駄木の地に創祀したと伝えている。",
          "period_text": "約千九百年前（伝承）",
          "event_date": null,
          "sort_order": 0,
          "verification_status": "source_confirmed",
          "confidence": "high",
          "verified_at": "2026-08-10T12:35:00+00:00",
          "note": "日本武尊による創祀という古代の伝承であり、確定年代を伴わないためhistory_type=traditionとする。",
          "source_keys": ["batch11-nedu-official"]
        },
        {
          "history_type": "historical_event",
          "title": "宝永三年の遷宮と社殿造営",
          "content": "根津神社の公式由緒は、宝永三年（1706）、五代将軍徳川綱吉の献納により千駄木の旧社地から現在地へ遷宮し、権現造りの社殿が造営されたとしている。文明年間（1469〜87）には太田道灌が社殿を奉建したとも記している。",
          "period_text": "宝永三年（1706）",
          "event_date": null,
          "sort_order": 1,
          "verification_status": "source_confirmed",
          "confidence": "high",
          "verified_at": "2026-08-10T12:35:00+00:00",
          "note": "特定の年代・寄進者を伴う記録のため、創祀伝承とは別のFactとして分離する。",
          "source_keys": ["batch11-nedu-official"]
