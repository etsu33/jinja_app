        {
          "history_type": "tradition",
          "title": "文正元年の創建伝承",
          "content": "小網神社の公式由緒は、文正元年（1466）、疫病が流行する中で稲穂を持った老人が現れて忽然と姿を消し、庵主の夢に恵心僧都が現れてこの老人を稲荷大神として祀るよう託宣したことから、小網稲荷大明神として創建されたと伝えている。",
          "period_text": "文正元年（1466）",
          "event_date": null,
          "sort_order": 0,
          "verification_status": "source_confirmed",
          "confidence": "high",
          "verified_at": "2026-08-10T12:30:00+00:00",
          "note": "夢告げを伴う創建伝承のため、history_type=traditionとし確定史実化しない。",
          "source_keys": ["batch11-koami-official"]
        }
      ]
