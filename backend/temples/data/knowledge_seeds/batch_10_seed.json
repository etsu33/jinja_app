      "histories": [
        {
          "history_type": "tradition",
          "title": "景行天皇41年の創建",
          "content": "大國魂神社の公式由緒は、第12代景行天皇41年（西暦111年）5月5日に、大國魂大神を武蔵国魂の神として祀ったことを創建の由来としている。",
          "period_text": "景行天皇41年（西暦111年）",
          "event_date": null,
          "sort_order": 0,
          "verification_status": "source_confirmed",
          "confidence": "high",
          "verified_at": "2026-08-10T11:10:00+00:00",
          "note": "景行天皇の在位年代は史料上確定していない古代の伝承的年代のため、history_type=traditionとし確定史実化しない。",
          "source_keys": ["batch10-okunitama-official"]
        },
        {
          "history_type": "historical_event",
          "title": "武蔵国府設置に伴う武蔵総社の確立",
          "content": "孝徳天皇の御代に武蔵国府が現在地へ置かれた際、当社が国衙の斎場となり、六所の神々を配祀して「武蔵総社」の起源が確立されたと公式由緒は伝えている。",
          "period_text": "孝徳天皇の御代（596-654年）",
          "event_date": null,
          "sort_order": 1,
          "verification_status": "source_confirmed",
          "confidence": "high",
          "verified_at": "2026-08-10T11:10:00+00:00",
          "note": "武蔵国府設置という制度的な歴史的出来事として扱い、景行天皇41年の創建伝承とは別のFactとして分離する。",
          "source_keys": ["batch10-okunitama-official"]
        }
      ]
