# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
# ios / android は app.config.ts から毎回生成する (CNG)。手で編集せず、
# コミットもしない。Expo の標準テンプレートにある記述だが、本リポジトリでは
# 抜けていた。無いと EAS Build が「gitignore されていない未追跡ファイル」として
# ローカルの生成物をアップロードし、app.config.ts の icon / splash / plugins が
# 無視されて古いネイティブプロジェクトでビルドされる。
/ios
/android
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
